<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Learn It, Love It</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="page">

    <!-- ── Header ── -->
    <header class="hero">
      <span class="hero__badge" aria-hidden="true">
        <svg class="icon">
          <path d="M12 7v14"/>
          <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
        </svg>
      </span>

      <h1 class="hero__title">Learn It, Love It</h1>
      <p class="hero__subtitle">Temas para aprender, votados por la comunidad.</p>

      <div class="stats-pill">
        <span class="stats-pill__item">
          <svg class="icon icon--sm">
            <path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/>
            <path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>
          </svg>
          <span><%= topics.length %> tema<%= topics.length !== 1 ? 's' : '' %></span>
        </span>
        <span class="stats-pill__dot" aria-hidden="true"></span>
        <span class="stats-pill__item">
          <svg class="icon icon--sm">
            <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.123 0 0 0 1.597-1.16z"/>
          </svg>
          <span><%= topics.reduce((acc, t) => acc + t.votos, 0) %> votos totales</span>
        </span>
      </div>
    </header>

    <!-- ── Lista de temas ── -->
    <section class="panel panel--list">
      <h2 class="panel__title">
        <svg class="icon">
          <path d="M12 7v14"/>
          <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
        </svg>
        Temas de aprendizaje
      </h2>

      <% if (topics.length === 0) { %>
        <p class="empty">Todavía no hay temas. ¡Agregá el primero!</p>
      <% } else { %>
        <ol id="topicsList" class="topics-list">
          <% topics.forEach(topic => { %>
            <li class="topic-card" data-votos="<%= topic.votos %>">

              <!-- Cabecera del tema -->
              <div class="topic-card__head">
                <span class="topic-card__rank" aria-hidden="true"></span>
                <h3 class="topic-card__name"><%= topic.nombre %></h3>

                <form class="vote-form" action="/topics/<%= topic.id %>/vote" method="POST">
                  <button class="btn btn--vote" type="submit" title="Votar este tema">Votos: <%= topic.votos %></button>
                </form>

                <form action="/topics/<%= topic.id %>/delete" method="POST">
                  <button class="btn btn--danger btn--icon" type="submit" title="Borrar tema" aria-label="Borrar tema">
                    <svg class="icon icon--sm">
                      <path d="M3 6h18"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                      <path d="M10 11v6"/><path d="M14 11v6"/>
                    </svg>
                  </button>
                </form>
              </div>

              <!-- Renombrar tema -->
              <form class="topic-card__edit" action="/topics/<%= topic.id %>/update" method="POST">
                <input class="input" type="text" name="nuevoNombre" value="<%= topic.nombre %>"
                       aria-label="Nuevo nombre del tema" placeholder="Nuevo nombre del tema">
                <button class="btn btn--edit" type="submit">
                  <svg class="icon icon--sm">
                    <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/>
                    <path d="m15 5 4 4"/>
                  </svg>
                  Guardar
                </button>
              </form>

              <!-- Enlaces del tema -->
              <div class="topic-card__links">
                <p class="micro-label">Enlaces útiles</p>

                <% if (topic.enlaces.length === 0) { %>
                  <p class="empty empty--sm">Todavía no hay enlaces.</p>
                <% } else { %>
                  <ul class="links-list">
                    <% topic.enlaces.forEach(enlace => { %>
                      <li class="link-item" data-votos="<%= enlace.votos %>">
                        <a class="link-item__url" href="<%= enlace.url %>" target="_blank" rel="noopener noreferrer">
                          <svg class="icon icon--sm">
                            <path d="M15 3h6v6"/><path d="M10 14 21 3"/>
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                          </svg>
                          <span class="link-item__url-text"><%= enlace.url %></span>
                        </a>

                        <div class="link-item__actions">
                          <form class="vote-form" action="/topics/<%= topic.id %>/links/<%= enlace.id %>/vote" method="POST">
                            <button class="btn btn--vote btn--xs" type="submit" title="Votar este enlace">Votos: <%= enlace.votos %></button>
                          </form>

                          <form action="/topics/<%= topic.id %>/links/<%= enlace.id %>/update" method="POST">
                            <input class="input input--xs" type="text" name="nuevaURL" value="<%= enlace.url %>"
                                   aria-label="Nueva URL del enlace" placeholder="https://ejemplo.com">
                            <button class="btn btn--edit btn--xs" type="submit">Guardar</button>
                          </form>

                          <form action="/topics/<%= topic.id %>/links/<%= enlace.id %>/delete" method="POST">
                            <button class="btn btn--danger btn--xs btn--icon" type="submit" title="Borrar enlace" aria-label="Borrar enlace">
                              <svg class="icon icon--sm">
                                <path d="M3 6h18"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <path d="M10 11v6"/><path d="M14 11v6"/>
                              </svg>
                            </button>
                          </form>
                        </div>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>

                <form class="form-add-link" action="/topics/<%= topic.id %>/links" method="POST">
                  <input class="input" type="text" name="link" placeholder="https://ejemplo.com"
                         aria-label="URL del enlace" required>
                  <button class="btn btn--soft" type="submit">
                    <svg class="icon icon--sm"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    Agregar enlace
                  </button>
                </form>
              </div>

            </li>
          <% }) %>
        </ol>
      <% } %>
    </section>

    <!-- ── Crear tema ── -->
    <section class="panel panel--cta">
      <h2 class="panel__title">
        <svg class="icon">
          <circle cx="12" cy="12" r="10"/>
          <path d="M8 12h8"/><path d="M12 8v8"/>
        </svg>
        Agregar nuevo tema
      </h2>

      <form class="form-new-topic" action="/topics" method="POST">
        <input class="input input--lg" type="text" name="nombre"
               placeholder="Ej: Aprender Node.js, Diseño UX…" aria-label="Nombre del tema" required>
        <button class="btn btn--primary" type="submit">
          <svg class="icon icon--sm"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Crear tema
        </button>
      </form>
    </section>

    <p class="page-footer">Learn It, Love It · <%= new Date().getFullYear() %></p>

  </div>

  <script src="/js/votes.js"></script>
</body>
</html>
